{
  "playwright": {
    "command": "npx",
    "args": ["@playwright/mcp@latest"]
  },
  "context7": {
    "command": "npx",
    "args": ["-y", "@upstash/context7-mcp"]
  },
  "mcp-obsidian": {
    "command": "npx",
    "args": ["-y", "mcp-obsidian"],
    "env": {
      "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}"
    }
  }
}
